# 用户配置：首次运行由 resources/config/default_config.yaml 自动生成
# 整个目录不入库，升级时不会覆盖你的改动
#
# 必须带前导 / 锚定到插件根目录。不加斜杠的 config/ 是「任意层级的同名目录」，
# 会连 src/config/（配置读取模块的源码）一起吞掉，导致仓库缺文件、CI 编译失败。
/config/

node_modules/

# 文档站构建产物（源码在 docs/，用 pnpm docs:build 生成）
# 两条都带斜杠锚定到仓库根。VitePress 的 tempDir 是 docs/.vitepress/.temp，
# 已被下面的 .temp/ 覆盖，不用单列。
docs/.vitepress/cache/
docs/.vitepress/dist/

# TypeScript 编译产物（源码在 src/，用 pnpm build 生成）
# 本地开发直接跑编译好的 js，但产物只由 CI 推到 js 分支，不进主分支
lib/
*.tsbuildinfo

# Tailwind 编译产物：由 pnpm build 的 build:css 步骤从 src/modules/render/tailwind.css
# 扫 lib/ 下的组件生成，运行时被 styles/index.ts 读进来内联。
# 不入库的理由同 lib/：它是编译产物，且内容取决于组件里当前有哪些 className，
# 入库会让每次改版式都带一个几百行的无意义 diff。
# CI 的「构建」步骤会生成它，「自检产物完整性」会断言它确实在。
/resources/template/css/

# web 面板产物：两份都由 pnpm build 生成，源码在 src/webui/。
#   panel.js  build:panel     esbuild 打包 main.tsx（含 React 运行时，约 200KB）
#   page.css  build:panel:css tailwind 扫 src/webui/*.tsx 出样式
# 理由同上——入库只会让每次改面板都带一个几百KB的无意义 diff。
# 两个 workflow 都会在构建后断言这两个文件存在（宿主按白名单取它们，缺一个就 403）。
# 名字不能是 page.js —— 宿主会把它当 Node 侧的页面描述符 import，见 webadapter/index.ts。
/webadapter/panel.js
/webadapter/page.css

# 开发笔记与设计稿：留在本地，不入库
#
# 注意别写成 docs/ —— 文档站（VitePress 源码）从 2.2.0 起就在 docs/，
# 那个目录是要入库的，由 .github/workflows/docs.yml 发到 gh-pages。
notes/

# 测试：留在本地，不入库
#
# 因此 CI 里没有「测试」步骤 —— 流水线从仓库克隆，克隆不到 test/ 就跑不了
# pnpm test。改回入库时记得把两个 workflow 的测试步骤加回来。
# 本地仍可 pnpm test（跑的是 lib/ 编译产物，先 pnpm build）。
test/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 运行时数据：中转计数的 sqlite 库（含 WAL 的 -wal / -shm 旁文件）
/data/

# 日志与临时文件
*.log
temp/
.temp/
