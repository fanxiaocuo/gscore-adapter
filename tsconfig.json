{
  // 注意：这份配置已经不再驱动构建。打包交给 tsdown（见 tsdown.config.ts），
  // tsc 只用来 `--noEmit` 做类型检查。下面的 outDir / declaration / sourceMap
  // 因此都不产出文件，保留是为了让编辑器与 tsc 对模块解析的判断和打包器一致。
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM 不是运行时依赖：渲染只把 JSX 拼成 HTML 字符串，不碰浏览器 API。
    // 但 JSX 的元素属性类型（className / style 等）定义在 DOM lib 里，缺了会全量报错。
    "lib": ["ES2024", "DOM"],

    // react-jsx：编译产物自动 import react/jsx-runtime，组件里不必再 import React。
    // react 是真运行时依赖，而 release / preview 分支只推 lib/ 与 resources/、
    // 不带 node_modules，所以那两个分支装完必须 pnpm install，详见 README「安装」。
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"]
    },

    "rootDir": "./src",
    "outDir": "./lib",

    "strict": true,
    // 插件大量 JSON 透传、平台差异字段、动态 Bot 对象访问，
    // 逐个标注成本高且阻碍快速迭代，先关闭最严格的三项。
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 生成 .d.ts 与 sourcemap，方便其它插件引用与调试
    "declaration": true,
    "sourceMap": true,

    // 全局 Bot / segment / logger / redis 声明
    "types": ["node", "trss-yunzai"]
  },
  "include": ["src/**/*"]
}
