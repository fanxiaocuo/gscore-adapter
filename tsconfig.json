{
  // 这份配置驱动构建：`tsc` 逐文件输出到 lib/，再由 `tsc-alias` 把 @/ 别名
  // 改写成相对路径。产物因此与 src/ 的目录结构一一对应，便于线上直接对读
  // （和 Yunzai-DF-Plugin 的产物形态一致）。
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    // 保持 bundler：源码里 @/xx 与 ./xx 都可以不写扩展名，写起来清爽。
    // 代价是 tsc 原样输出这些路径，而 Node ESM 既不认省略的 .js 也不认目录导入，
    // 所以补全扩展名这步必须由下面的 tsc-alias.resolveFullPaths 兜住。
    "moduleResolution": "bundler",
    // DOM 不是运行时依赖：渲染只把 JSX 拼成 HTML 字符串，不碰浏览器 API。
    // 但 JSX 的元素属性类型（className / style 等）定义在 DOM lib 里，缺了会全量报错。
    "lib": ["ES2024", "DOM"],

    // react-jsx：编译产物自动 import react/jsx-runtime，组件里不必再 import React。
    // react 是真运行时依赖，而 release / preview 分支只推 lib/ 与 resources/、
    // 不带 node_modules，所以那两个分支装完必须 pnpm install，详见 README「安装」。
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"]
    },

    "rootDir": "./src",
    "outDir": "./lib",

    "strict": true,
    // strictNullChecks 与 strictPropertyInitialization 仍关着，原因不同，别一起打开：
    //
    // strictNullChecks —— 云崽的事件与 Bot 对象上大量字段「可能没有」，而框架自身
    //   （@types/trss-yunzai）就是在关着这个开关的前提下写的：Client.uin 之类的字段
    //   都不带 | undefined。打开后报的多半是**声明**没标可选，不是我们的代码有 bug，
    //   逐个 ! 断言只是把噪音搬到代码里。
    //   注意：关着它意味着 `if (x == null) return x` **不会**把 null 从类型里收窄掉，
    //   写这种守卫时要 return 字面量（utils/media.ts 的 readStream 有过这个坑）。
    //
    // strictPropertyInitialization —— 只在 strictNullChecks 打开时才有意义，
    //   跟着它一起留着。
    //
    // noImplicitAny 已打开：全项目参数与绑定都标了类型，事件用 AdapterEvent，
    //   开放集（消息段、发送返回值）用「已知字段 + 索引签名」而不是裸 any。
    //   新代码请照这个路子标，不要为了过编译写 `: any`。
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 生成 .d.ts 与 sourcemap，方便其它插件引用与调试
    "declaration": true,
    "sourceMap": true,

    // 全局 Bot / segment / logger / redis 声明
    "types": ["node", "trss-yunzai"]
  },
  "include": ["src/**/*"],
  // src/webui/ 是 web 面板的**浏览器**代码，由 build:panel 用 Vite 单独打包成
  // webadapter/panel.js，不该经 tsc 进 lib/：那份产物永远不会被 Node 侧 import，
  // 只会白占体积；而且它 import 的是 react-dom/client（浏览器入口），
  // 跟着 lib/ 发出去反而容易被误当成服务端模块。
  // 排除后它就不受 tsc --noEmit 管了，而打包器只剥类型不校验（实测塞一个
  // const x: number = "字符串" 照样退出码 0）。所以另备了 tsconfig.webui.json，
  // typecheck 脚本会把两份都跑一遍。
  "exclude": ["src/webui"],
  // 少了这条，产物里就是 `from "./config"` 这种光秃秃的路径——tsc 原样保留，
  // 而 Node ESM 不做扩展名补全也不支持目录导入，一跑就是
  // ERR_UNSUPPORTED_DIR_IMPORT / ERR_MODULE_NOT_FOUND。开了以后会补成
  // `./config/index.js`。构建期不报错，只在运行时炸，所以别删。
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
