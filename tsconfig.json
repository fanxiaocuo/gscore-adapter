{
  // 这份配置驱动构建：`tsc` 逐文件输出到 lib/，再由 `tsc-alias` 把 @/ 别名
  // 改写成相对路径。产物因此与 src/ 的目录结构一一对应，便于线上直接对读
  // （和 Yunzai-DF-Plugin 的产物形态一致）。
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    // 保持 bundler：源码里 @/xx 与 ./xx 都可以不写扩展名，写起来清爽。
    // 代价是 tsc 原样输出这些路径，而 Node ESM 既不认省略的 .js 也不认目录导入，
    // 所以补全扩展名这步必须由下面的 tsc-alias.resolveFullPaths 兜住。
    "moduleResolution": "bundler",
    // DOM 不是运行时依赖：渲染只把 JSX 拼成 HTML 字符串，不碰浏览器 API。
    // 但 JSX 的元素属性类型（className / style 等）定义在 DOM lib 里，缺了会全量报错。
    "lib": ["ES2024", "DOM"],

    // react-jsx：编译产物自动 import react/jsx-runtime，组件里不必再 import React。
    // react 是真运行时依赖，而 release / preview 分支只推 lib/ 与 resources/、
    // 不带 node_modules，所以那两个分支装完必须 pnpm install，详见 README「安装」。
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"]
    },

    "rootDir": "./src",
    "outDir": "./lib",

    "strict": true,
    // 插件大量 JSON 透传、平台差异字段、动态 Bot 对象访问，
    // 逐个标注成本高且阻碍快速迭代，先关闭最严格的三项。
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // 生成 .d.ts 与 sourcemap，方便其它插件引用与调试
    "declaration": true,
    "sourceMap": true,

    // 全局 Bot / segment / logger / redis 声明
    "types": ["node", "trss-yunzai"]
  },
  "include": ["src/**/*"],
  // 少了这条，产物里就是 `from "./config"` 这种光秃秃的路径——tsc 原样保留，
  // 而 Node ESM 不做扩展名补全也不支持目录导入，一跑就是
  // ERR_UNSUPPORTED_DIR_IMPORT / ERR_MODULE_NOT_FOUND。开了以后会补成
  // `./config/index.js`。构建期不报错，只在运行时炸，所以别删。
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
