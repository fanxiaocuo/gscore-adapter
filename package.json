{
  "name": "gscore-adapter",
  "version": "2.1.0",
  "description": "早柚核心（gsuid_core）适配器，兼容 TRSS-Yunzai 与 Miao-Yunzai",
  "keywords": [
    "Yunzai",
    "gsuid_core",
    "早柚核心"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "rimraf lib && tsc && tsc-alias",
    "build:watch": "rimraf lib && tsc && concurrently \"tsc -w\" \"tsc-alias -w\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "chokidar": ">=4",
    "ws": ">=8",
    "yaml": ">=2"
  },
  "peerDependenciesMeta": {
    "chokidar": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/trss-yunzai": "npm:@kaguyajs/trss-yunzai-types@^1.3.2",
    "@types/ws": "^8.18.1",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "sqlite3": "npm:@karinjs/sqlite3@^0.4.3",
    "ws": "^8.19.0",
    "yaml": "^2.8.2"
  },
  "files": [
    "./lib",
    "./resources",
    "./index.js",
    "./guoba.support.js",
    "./README.md",
    "./CHANGELOG.md",
    "./LICENSE"
  ]
}
