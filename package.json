{
  "name": "gscore-adapter",
  "version": "2.2.0",
  "description": "早柚核心（gsuid_core）适配器，兼容 TRSS-Yunzai 与 Miao-Yunzai",
  "keywords": [
    "Yunzai",
    "gsuid_core",
    "早柚核心"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "rimraf lib && tsc && tsc-alias && pnpm run build:css && pnpm run build:panel:css && pnpm run build:panel",
    "build:css": "tailwindcss -i src/modules/render/styles/tailwind.css -o resources/template/css/tailwind.css --minify",
    "build:panel:css": "tailwindcss -i src/webui/styles.css -o webadapter/page.css --minify",
    "build:panel": "esbuild src/webui/main.tsx --bundle --minify --format=iife --jsx=automatic --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=webadapter/page.js --log-level=warning",
    "build:watch": "concurrently \"tsc -w\" \"tsc-alias -w\" \"tailwindcss -i src/modules/render/styles/tailwind.css -o resources/template/css/tailwind.css --watch\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webui.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test \"test/*.test.mjs\"",
    "preview": "node --import tsx test/preview.mjs",
    "contrast": "node --import tsx test/contrast.mjs",
    "dev": "node --import tsx test/dev.mjs",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:preview": "pnpm --dir docs preview"
  },
  "dependencies": {
    "@karinjs/template-react": "https://pkg.pr.new/KarinJS/template-react/@karinjs/template-react@169c6ed",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "chokidar": ">=4",
    "ws": ">=8",
    "yaml": ">=2"
  },
  "peerDependenciesMeta": {
    "chokidar": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4",
    "@types/node": "^24.10.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/trss-yunzai": "npm:@kaguyajs/trss-yunzai-types@^1.3.2",
    "@types/ws": "^8.18.1",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "rimraf": "^6.1.3",
    "sqlite3": "npm:@karinjs/sqlite3@^0.4.3",
    "tailwindcss": "^4",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "ws": "^8.19.0",
    "yaml": "^2.8.2"
  },
  "files": [
    "./lib",
    "./resources",
    "./webadapter",
    "./index.js",
    "./guoba.support.js",
    "./README.md",
    "./CHANGELOG.md",
    "./LICENSE"
  ]
}
